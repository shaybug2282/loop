# Server-side only (Vercel env vars — never exposed to the browser)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here
# OAuth client secret for the Google authorization-code exchange
# (Google Cloud Console → Credentials → your Web application client)
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# Optional: dedicated HMAC key for session cookies; when unset, a session key
# is derived from TOKEN_ENCRYPTION_KEY
# SESSION_SECRET=your_random_secret_here

# Client-side (REACT_APP_* vars are inlined into the JS bundle by CRA)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Also read server-side by api/_lib.js for the Supabase connection URL
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co
