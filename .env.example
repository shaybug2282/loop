# Server-side only (Vercel env vars — never exposed to the browser)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_char_hex_key_here

# Client-side (REACT_APP_* vars are inlined into the JS bundle by CRA)
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
# Also read server-side by api/_lib.js for the Supabase connection URL
REACT_APP_SUPABASE_URL=https://xxxx.supabase.co# Optional — authenticates the daily Vercel cron (profile refresh). When set,
# Vercel sends it automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=your_random_cron_secret_here
